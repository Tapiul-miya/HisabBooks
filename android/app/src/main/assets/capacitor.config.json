{
	"appId": "com.hisabbook.app",
	"appName": "Hisab Book",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"allowNavigation": [
			"accounts.google.com",
			"*.google.com",
			"*.firebaseapp.com",
			"*.googleapis.com"
		]
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 0,
			"launchAutoHide": true,
			"backgroundColor": "#0F380F",
			"androidSplashResourceName": "splash",
			"androidScaleType": "CENTER_CROP",
			"showSpinner": false
		}
	}
}
